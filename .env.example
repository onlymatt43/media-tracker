TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
ADMIN_SECRET=your-admin-secret

# Bunny Stream embed host, used to build the iframe URL for stream media.
# Required only when serving a stream media; a missing value fails loudly.
BUNNY_STREAM_EMBED_HOST=iframe.mediadelivery.net

# Site identity for the root <head> (src/lib/site-config.js). Every entry is
# optional: an unset value is omitted from the page, never replaced.
# Display name used as <title>, og:site_name and on the root page.
# Unset -> the package name from package.json.
SITE_BRAND_NAME=
# Meta description shared with Open Graph and Twitter cards.
SITE_DESCRIPTION=
# BCP-47 tag for <html lang> and og:locale (language-region form). Unset -> "en" lang, no og:locale.
SITE_LOCALE=
# Canonical public origin (scheme + host), used as metadataBase.
SITE_URL=
# Absolute URL of the Open Graph / Twitter share image.
SITE_OG_IMAGE_URL=
# Base URL of the shared favicon set; the app appends /favicon-32.png, /favicon.ico, etc.
SITE_FAVICON_BASE_URL=

# Legal identity for the privacy page (src/app/privacy/page.js). Both optional:
# an unset value is omitted from the page, never replaced by a placeholder.
# Legal name of the operator responsible for the collected data.
SITE_OPERATOR_NAME=
# Contact address for access, correction and deletion requests.
SITE_CONTACT_EMAIL=

# --- Admin sign-in (added 2026-09-15) -----------------------------------------
# The session cookie the admin holds after signing in. Both are required: the
# admin pages and the dashboard refuse to answer without them.
# A long random string; changing it signs everyone out.
TRACKER_SESSION_SECRET=
# How long that session lasts, in seconds.
TRACKER_SESSION_TTL_SECONDS=

# --- Sign-in from the owner's portal (added 2026-09-15) -----------------------
# A pass signed by admin.onlymatt.ca opens this admin without a password. This
# system holds the PUBLIC half only: it verifies a pass and cannot make one.
# Ed25519, SPKI DER in base64 — read it from the portal's own /pass-key page.
PORTAL_PASS_PUBLIC_KEY=
# Which system a pass must be addressed to, so a pass for one system cannot
# open another.
PORTAL_PASS_AUDIENCE=
# The longest life a pass may claim; anything longer is refused whatever it says.
PORTAL_PASS_MAX_TTL_SECONDS=

